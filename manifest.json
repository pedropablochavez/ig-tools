{
  "manifest_version": 3,
  "name": "IG Tools (Unofficial)",
  "version": "2.4.0",
  "minimum_chrome_version": "116",
  "description": "View full-size profile photos, save posts and stories, and hear photo-post music. Unofficial; not affiliated with Meta.",
  "homepage_url": "https://pedropablochavez.github.io/ig-tools/",
  "permissions": [
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "mp4fix.js",
        "music-player.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
